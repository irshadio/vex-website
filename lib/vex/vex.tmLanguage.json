{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "vex",
  "displayName": "Vex",
  "scopeName": "source.vex",
  "fileTypes": ["vx"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.vex", "match": "///.*$" },
        { "name": "comment.line.double-slash.vex", "match": "//.*$" },
        { "name": "comment.block.vex", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.vex",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.vex", "match": "\\\\." },
        {
          "name": "meta.interpolation.vex",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.vex" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.vex" } },
          "patterns": [{ "include": "$self" }]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.vex", "match": "\\b0x[0-9A-Fa-f_]+\\b" },
        { "name": "constant.numeric.vex", "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?\\b" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.declaration.function.vex" }, "2": { "name": "entity.name.function.vex" } }
        },
        {
          "match": "\\b(struct|enum|interface|extension|typedef)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.declaration.type.vex" }, "2": { "name": "entity.name.type.vex" } }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.vex", "match": "\\b(if|else|while|for|in|return|break|continue|match|guard|throw|try|catch|await)\\b(\\?)?" },
        { "name": "keyword.other.vex", "match": "\\b(fn|let|var|struct|static|const|typedef|enum|interface|extension|import|extern|pub|as|throws|async)\\b" },
        { "name": "constant.language.vex", "match": "\\b(true|false|nil)\\b" },
        { "name": "variable.language.self.vex", "match": "\\bself\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.vex", "match": "\\b(int|float|double|string|bool|char|void|any)\\b" },
        { "name": "entity.name.type.vex", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.vex" } }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.vex", "match": "=>|->|\\?\\?|\\?\\.|\\.\\.<|\\.\\.|[-+*/%=!<>&|^~?:]+" }
      ]
    }
  }
}
